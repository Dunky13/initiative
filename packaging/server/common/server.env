# Required: supply a strong key (openssl rand -hex 32), database owner connection,
# and the public URL. There are deliberately no shared credentials.
# DATABASE_URL must address an operator-provisioned PostgreSQL 17 database.
SECRET_KEY=
DATABASE_URL=
APP_URL=

# Listen on loopback until a reverse proxy or LAN binding is configured.
INITIATIVE_HOST=127.0.0.1
INITIATIVE_PORT=8173
BEHIND_PROXY=false
# Only these proxy addresses may supply forwarded client addresses.
FORWARDED_ALLOW_IPS=127.0.0.1,::1
UPLOADS_DIR=/var/lib/initiative/uploads
ENABLE_PUBLIC_REGISTRATION=false
# Optional: set FIRST_OWNER_EMAIL and FIRST_OWNER_PASSWORD for a bootstrap owner,
# or temporarily allow registration while making the first account privately.
# More options are documented in backend/.env.example in the source release.
