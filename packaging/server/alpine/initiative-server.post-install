#!/bin/sh
set -eu
# Prepare the root-owned state directory before creating writable storage.
if [ -L /var/lib/initiative ] || { [ -e /var/lib/initiative ] && [ ! -d /var/lib/initiative ]; }; then
    echo 'Refusing non-directory or symlink at /var/lib/initiative' >&2
    exit 1
fi
mkdir -p /var/lib/initiative
chown root:initiative /var/lib/initiative
chmod 0750 /var/lib/initiative
for directory in /var/lib/initiative/uploads /var/log/initiative; do
    if [ -L "$directory" ] || { [ -e "$directory" ] && [ ! -d "$directory" ]; }; then
        echo "Refusing non-directory or symlink at $directory" >&2
        exit 1
    fi
done
install -d -o initiative -g initiative -m 0750 /var/lib/initiative/uploads /var/log/initiative
chown root:initiative /etc/initiative /etc/initiative/server.env
chmod 0750 /etc/initiative
chmod 0640 /etc/initiative/server.env
echo 'Configure /etc/initiative/server.env, then manually rc-update add initiative-server and rc-service initiative-server start.'
